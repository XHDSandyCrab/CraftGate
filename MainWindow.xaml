<Window x:Class="CraftGate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:CraftGate.Views"
        xmlns:fluent="clr-namespace:FluentWpfCore.AttachedProperties;assembly=FluentWpfCore"
        Title="CraftGate"
        Icon="pack://application:,,,/CraftGate;component/Assets/app_icon.png"
        Width="1180" Height="740"
        MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="Transparent"
        FontFamily="Microsoft YaHei UI"
        StateChanged="Window_StateChanged">

    <!-- 原生 WindowChrome：系统级接管非客户区，拖动/Snap/最大化边界/DWM 动画由它提供 -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="-1"
                            CornerRadius="8"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>


    <Grid x:Name="RootGrid">
        <!-- 自定义图片背景层：仅当背景材质选"图片"时显示，铺满整个窗口 -->
        <Border x:Name="ImageBackground" Visibility="Collapsed" IsHitTestVisible="False"/>

        <Border x:Name="RootBorder" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧导航栏（详情弹窗打开时平滑模糊） -->
                <Border x:Name="LeftNavBorder" Grid.Column="0" Background="#1A1C21">
                    <Border.Effect>
                        <BlurEffect x:Name="LeftNavBlur" Radius="0"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="48"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Background="Transparent">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                                <Image Source="pack://application:,,,/CraftGate;component/Assets/app_icon.png" Width="24" Height="24"
                                       VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="CraftGate" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="1" Margin="0,20,0,0" HorizontalAlignment="Center">
                            <RadioButton x:Name="NavLaunch" GroupName="Nav" Style="{StaticResource NavButtonStyle}" Tag="launch" IsChecked="True" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="启动" FontSize="14" FontWeight="SemiBold" Margin="16,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="Nav" Style="{StaticResource NavButtonStyle}" Tag="download" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="下载" FontSize="14" FontWeight="SemiBold" Margin="16,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="Nav" Style="{StaticResource NavButtonStyle}" Tag="resource" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="资源" FontSize="14" FontWeight="SemiBold" Margin="16,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="Nav" Style="{StaticResource NavButtonStyle}" Tag="account" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="账户" FontSize="14" FontWeight="SemiBold" Margin="16,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="Nav" Style="{StaticResource NavButtonStyle}" Tag="settings" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="设置" FontSize="14" FontWeight="SemiBold" Margin="16,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="0" Width="1" Background="{StaticResource CardBorderBrush}" HorizontalAlignment="Right" Margin="0,70,0,70" />

                <!-- 右侧主内容区 -->
                <Border x:Name="RightContentBorder" Grid.Column="1" Background="#15161A">
                    <Grid x:Name="ContentRootGrid">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="48"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                                <Button x:Name="BtnMinimize" Style="{StaticResource CaptionButtonStyle}" Content="&#xE921;" Click="Minimize_Click"/>
                                <Button x:Name="BtnMaximize" Style="{StaticResource CaptionButtonStyle}" Content="&#xE922;" Click="Maximize_Click"/>
                                <Button Style="{StaticResource CaptionCloseButtonStyle}" Content="&#xE8BB;" Click="Close_Click"/>
                            </StackPanel>
                        </Grid>

                        <ContentControl x:Name="ContentHost" Grid.Row="1">
                            <ContentControl.Effect>
                                <BlurEffect x:Name="ContentBlur" Radius="0"/>
                            </ContentControl.Effect>
                        </ContentControl>

                        <views:DownloadCenterView x:Name="DownloadCenter" Grid.Row="1" Visibility="Collapsed" RenderTransformOrigin="1,1">
                            <views:DownloadCenterView.RenderTransform>
                                <ScaleTransform ScaleX="0.1" ScaleY="0.1"/>
                            </views:DownloadCenterView.RenderTransform>
                        </views:DownloadCenterView>

                        <!-- 通知详情弹窗（由通知 morph 而来，居中不满屏） -->
                        <views:DownloadDetailPopup x:Name="ToastDetailPopup" Grid.Row="1"
                                                   Visibility="Collapsed" IsHitTestVisible="False" Panel.ZIndex="10000"/>

                        <!-- 新版本提示弹窗（更新日志 + 立即更新 + 关闭叉叉） -->
                        <views:UpdateDialog x:Name="UpdatePromptDialog" Grid.Row="1"
                                            Visibility="Collapsed" IsHitTestVisible="False" Panel.ZIndex="10002"/>

                        <!-- 通知本体：下载类点击可展开详情弹窗；只读通知不响应。Z 序高于遮罩 -->
                        <StackPanel x:Name="ToastContainer" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                    Margin="0,0,16,16" Panel.ZIndex="10001"
                                    MouseLeftButtonUp="ToastContainer_MouseLeftButtonUp" Cursor="Arrow"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>