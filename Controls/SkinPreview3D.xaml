<UserControl x:Class="CraftGate.Controls.SkinPreview3D"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ClipToBounds="True">
    <Grid>
        <!-- 脚下投影：径向渐变椭圆，2D层比3D阴影平面省很多性能 -->
        <Ellipse x:Name="GroundShadow" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                 Width="62" Height="15" Margin="0,0,0,4" Opacity="0.55" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#A0000000" Offset="0"/>
                    <GradientStop Color="#50000000" Offset="0.55"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.Effect>
                <BlurEffect Radius="4"/>
            </Ellipse.Effect>
        </Ellipse>

        <Viewport3D x:Name="Viewport" RenderOptions.EdgeMode="Aliased">
            <Viewport3D.Camera>
                <!-- 正视相机，立体感由模型自身的 3/4 旋转提供 -->
                <PerspectiveCamera Position="0, 0, 48"
                                   LookDirection="0, 0, -1"
                                   UpDirection="0, 1, 0"
                                   FieldOfView="45"/>
            </Viewport3D.Camera>

            <ModelVisual3D>
                <ModelVisual3D.Content>
                    <Model3DGroup>
                        <AmbientLight Color="#FF9A9A9A"/>
                        <DirectionalLight Color="#FFFFFFFF" Direction="-0.6, -1, -0.8"/>
                        <DirectionalLight Color="#FF555566" Direction="0.7, 0.3, 1"/>
                    </Model3DGroup>
                </ModelVisual3D.Content>
            </ModelVisual3D>

            <ModelVisual3D x:Name="ModelHost"/>
        </Viewport3D>
    </Grid>
</UserControl>
