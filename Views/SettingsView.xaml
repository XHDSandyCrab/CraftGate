<UserControl x:Class="CraftGate.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:CraftGate.Helpers">
    <UserControl.Resources>
        <!-- 材质选项卡片按钮：效果1（描边闪现+内容模糊+中间图标），选中时绿色边框保留 -->
        <Style x:Key="MaterialOptionStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="112"/>
            <Setter Property="Height" Value="72"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card" Background="#1AFFFFFF" CornerRadius="8" BorderBrush="Transparent" BorderThickness="2">
                            <Grid>
                                <!-- 效果1：内容高斯模糊 -->
                                <Grid x:Name="CardContent">
                                    <Grid.Effect><BlurEffect Radius="0"/></Grid.Effect>
                                    <TextBlock Text="{TemplateBinding Content}" FontSize="15" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <!-- 效果1：中间图标浮现（每个材质不同，绑定 IconCode） -->
                                <TextBlock x:Name="HoverIcon" Text="{Binding IconCode}"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="30"
                                           Foreground="{StaticResource AccentBrush}" Opacity="0"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#2DFFFFFF"/>
                                <!-- 效果1要素①：描边瞬间变色（选中态 DataTrigger 在后面，选中时仍保持绿框） -->
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Card" Property="Background" Value="#203DDC84"/>
                            </DataTrigger>
                            <!-- 效果1：MouseEnter/MouseLeave 动模糊和图标 -->
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CardContent" Storyboard.TargetProperty="(UIElement.Effect).(BlurEffect.Radius)" To="6" Duration="0:0:0.2" FillBehavior="HoldEnd"/>
                                        <DoubleAnimation Storyboard.TargetName="HoverIcon" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" FillBehavior="HoldEnd"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CardContent" Storyboard.TargetProperty="(UIElement.Effect).(BlurEffect.Radius)" To="0" Duration="0:0:0.2" FillBehavior="HoldEnd"/>
                                        <DoubleAnimation Storyboard.TargetName="HoverIcon" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" FillBehavior="HoldEnd"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 按钮卡片样式 -->
        <Style x:Key="MaterialCardStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#1AFFFFFF"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="16,12">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2DFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="40">
        <Border Style="{StaticResource CardStyle}" Padding="32">
            <!-- 👇 加上 ScrollViewer -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <!-- 👇 使用 StackPanel 垂直排列，绝对不会重叠 -->
                <StackPanel>
                    <TextBlock Text="启动器设置" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,32"/>

                    <!-- 1. 启动项管理 -->
                    <StackPanel Margin="0,0,0,32">
                        <TextBlock Text="启动项管理" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="创建和管理快捷启动项，如安全模式、纯净模式等" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>
                        <!-- 效果1：模糊 + 中间图标（Tag），各按钮图标不同 -->
                        <Button Content="管理自定义启动项" Command="{Binding ManageLaunchOptionsCommand}" Style="{StaticResource SubtleHoverButtonStyle}"
                                Tag="&#xE713;" MinWidth="160" Padding="16,12" HorizontalAlignment="Left" />
                    </StackPanel>

                    <!-- 2. 版本隔离 -->
                    <Grid Margin="0,0,0,32">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="版本隔离" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="将存档、模组和配置文件独立保存在各自版本目录下" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" IsChecked="{Binding EnableVersionIsolation}" VerticalAlignment="Center">
                            <CheckBox.Template>
                                <ControlTemplate TargetType="CheckBox">
                                    <Border x:Name="Track" Width="48" Height="26" CornerRadius="13">
                                        <Border.Background>
                                            <SolidColorBrush Color="#3A3D44"/>
                                        </Border.Background>
                                        <Border x:Name="Thumb" Width="22" Height="22" Background="White" CornerRadius="11" HorizontalAlignment="Left" Margin="2,0,0,0" RenderTransformOrigin="0.5,0.5">
                                            <Border.RenderTransform>
                                                <TranslateTransform X="0"/>
                                            </Border.RenderTransform>
                                        </Border>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Track" Property="Background" Value="#3DDC84"/>
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="22" Duration="0:0:0.2">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.2">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </CheckBox.Template>
                        </CheckBox>
                    </Grid>

                    <!-- 2.5 打开文件夹 -->
                    <StackPanel Margin="0,0,0,32">
                        <TextBlock Text="游戏文件夹" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="存档、模组、配置按账户隔离，位于 版本/accounts/账户ID/ 下" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" TextWrapping="Wrap"/>
                        <TextBlock Text="💡 温馨提示：不同游戏版本、不同账户的文件夹是分开的，请确认打开的是你当前使用的版本与账户。" FontSize="11" Foreground="#FFD47A" Margin="0,0,0,14" TextWrapping="Wrap"/>
                        <WrapPanel>
                            <Button Content="账户文件夹" Command="{Binding OpenAccountFolderCommand}" Style="{StaticResource SubtleHoverButtonStyle}" Tag="&#xE838;" MinWidth="130" Padding="12,10" Margin="0,0,10,10"/>
                            <Button Content="存档 saves" Command="{Binding OpenSavesFolderCommand}" Style="{StaticResource SubtleHoverButtonStyle}" Tag="&#xE8B7;" MinWidth="130" Padding="12,10" Margin="0,0,10,10"/>
                            <Button Content="模组 mods" Command="{Binding OpenModsFolderCommand}" Style="{StaticResource SubtleHoverButtonStyle}" Tag="&#xE9E9;" MinWidth="130" Padding="12,10" Margin="0,0,10,10"/>
                            <Button Content="配置 config" Command="{Binding OpenConfigFolderCommand}" Style="{StaticResource SubtleHoverButtonStyle}" Tag="&#xE713;" MinWidth="130" Padding="12,10" Margin="0,0,10,10"/>
                            <Button Content="游戏根目录" Command="{Binding OpenGameRootFolderCommand}" Style="{StaticResource SubtleHoverButtonStyle}" Tag="&#xE8DA;" MinWidth="130" Padding="12,10" Margin="0,0,10,10"/>
                        </WrapPanel>
                    </StackPanel>

                    <!-- 3. 最大下载线程数 -->
                    <Grid Margin="0,0,0,32">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="最大下载线程数" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="多线程分块下载数量（推荐 8-16，最大 64）" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" Text="{Binding DownloadThreads, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DarkTextBoxStyle}" Width="80" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" TextAlignment="Center"/>
                    </Grid>

                    <!-- 4. 国内镜像 -->
                    <Grid Margin="0,0,0,32">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="使用国内镜像加速" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="下载游戏和资源时使用 BMCLAPI 镜像" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" IsChecked="{Binding UseMirror}" VerticalAlignment="Center">
                            <CheckBox.Template>
                                <ControlTemplate TargetType="CheckBox">
                                    <Border x:Name="Track" Width="48" Height="26" CornerRadius="13">
                                        <Border.Background>
                                            <SolidColorBrush Color="#3A3D44"/>
                                        </Border.Background>
                                        <Border x:Name="Thumb" Width="22" Height="22" Background="White" CornerRadius="11" HorizontalAlignment="Left" Margin="2,0,0,0" RenderTransformOrigin="0.5,0.5">
                                            <Border.RenderTransform>
                                                <TranslateTransform X="0"/>
                                            </Border.RenderTransform>
                                        </Border>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Track" Property="Background" Value="#3DDC84"/>
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="22" Duration="0:0:0.2">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.2">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </CheckBox.Template>
                        </CheckBox>
                    </Grid>

                    <!-- 5. 最大内存分配 -->
                    <Grid Margin="0,0,0,32">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="最大内存分配 (MB)" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="分配给游戏的最大运行内存（推荐 4096 或 8192）" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" Text="{Binding MaxMemoryMB, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DarkTextBoxStyle}" Width="100" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" TextAlignment="Center"/>
                    </Grid>

                    <!-- 7. 窗口背景材质 -->
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="窗口背景" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="选择窗口背景材质，云母/亚克力/毛玻璃需要 Windows 11 22H2 及以上" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12" TextWrapping="Wrap"/>

                        <ItemsControl ItemsSource="{Binding MaterialOptions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource MaterialOptionStyle}"
                                            Content="{Binding Name}"
                                            Command="{Binding DataContext.SelectMaterialCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Value}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 图片背景的选择入口 -->
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0" VerticalAlignment="Center">
                            <Button Content="选择背景图片…" Command="{Binding SelectImageCommand}"
                                    Style="{StaticResource SubtleHoverButtonStyle}" Tag="&#xE91B;"
                                    MinWidth="140" Padding="12,10" HorizontalAlignment="Left"/>
                            <TextBlock Text="{Binding BackgroundImagePath}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                       Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="260"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 8. 检查更新（效果1：描边闪现 + 高斯模糊 + 中间图标浮现） -->
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="关于与更新" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding CurrentVersionText}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>

                        <Border Background="#0AFFFFFF" BorderThickness="2" CornerRadius="6" Height="64"
                                Cursor="Hand" ClipToBounds="True" Padding="0"
                                MouseLeftButtonUp="UpdateCard_MouseLeftButtonUp">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Style.Triggers>
                                        <!-- 效果1要素①：描边瞬间闪现（不用 BorderTraceBehavior） -->
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <!-- 效果1要素②：内容高斯模糊 -->
                                <Grid x:Name="UpdateCardContent">
                                    <Grid.Effect>
                                        <BlurEffect Radius="0"/>
                                    </Grid.Effect>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#14FFFFFF" CornerRadius="6,0,0,6" Padding="12">
                                        <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="28" Foreground="{StaticResource AccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                                        <TextBlock Text="检查更新" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="检查是否有新版本可用" FontSize="12" Margin="0,2,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Grid>
                                <!-- 效果1要素③：图标在中间平滑出现 -->
                                <TextBlock x:Name="UpdateHoverIcon" Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="30" Foreground="{StaticResource AccentBrush}" Opacity="0"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            </Grid>

                            <Border.Triggers>
                                <EventTrigger RoutedEvent="MouseEnter">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="UpdateCardContent" Storyboard.TargetProperty="(UIElement.Effect).(BlurEffect.Radius)" To="6" Duration="0:0:0.2" FillBehavior="HoldEnd"/>
                                            <DoubleAnimation Storyboard.TargetName="UpdateHoverIcon" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" FillBehavior="HoldEnd"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="MouseLeave">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="UpdateCardContent" Storyboard.TargetProperty="(UIElement.Effect).(BlurEffect.Radius)" To="0" Duration="0:0:0.2" FillBehavior="HoldEnd"/>
                                            <DoubleAnimation Storyboard.TargetName="UpdateHoverIcon" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" FillBehavior="HoldEnd"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                        </Border>

                        <!-- 更新状态上拉菜单（和游戏选择菜单同款：ToggleButton + Popup 上拉 + 上滑动画，不用图标） -->
                        <Grid Margin="0,12,0,0">
                            <!-- 效果2：鼠标发射绿色描边（唯一用效果2的按钮） -->
                            <ToggleButton x:Name="UpdateModeBtn" IsChecked="{Binding IsUpdateMenuOpen}"
                                          HorizontalAlignment="Stretch" Height="44" Cursor="Hand"
                                          Background="#0AFFFFFF" BorderThickness="0"
                                          helpers:BorderTraceBehavior.Enabled="True"
                                          helpers:BorderTraceBehavior.TraceRadius="8">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8" Padding="14,0">
                                            <Grid>
                                                <TextBlock Text="{Binding UpdateStatusText}" Foreground="{StaticResource TextPrimaryBrush}"
                                                           FontSize="13" VerticalAlignment="Center"/>
                                                <Path x:Name="Arrow" Data="M 0,5 L 5,0 L 10,5" Stroke="{StaticResource AccentBrush}"
                                                      StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                      RenderTransformOrigin="0.5,0.5">
                                                    <Path.RenderTransform><RotateTransform Angle="0"/></Path.RenderTransform>
                                                </Path>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="Arrow" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="180" Duration="0:0:0.2">
                                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="Arrow" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="0" Duration="0:0:0.2">
                                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="#1AFFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="UpdateModePopup" PlacementTarget="{Binding ElementName=UpdateModeBtn}"
                                   Placement="Top" HorizontalOffset="0" VerticalOffset="-4" StaysOpen="False"
                                   AllowsTransparency="True" IsOpen="{Binding IsUpdateMenuOpen, Mode=TwoWay}" PopupAnimation="None">
                                <Border Background="#1E2025" BorderBrush="{StaticResource CardBorderBrush}"
                                        BorderThickness="1" CornerRadius="8" Width="240" RenderTransformOrigin="0.5,1">
                                    <Border.RenderTransform><TranslateTransform Y="20"/></Border.RenderTransform>
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.5" Color="Black"/>
                                    </Border.Effect>
                                    <Border.Triggers>
                                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2"/>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="20" To="0" Duration="0:0:0.25">
                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Border.Triggers>
                                    <StackPanel Margin="6">
                                        <!-- 自动更新 -->
                                        <Button Command="{Binding SetUpdateModeCommand}" CommandParameter="True"
                                                Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" Margin="0,0,0,4">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="ItemBg" Background="{TemplateBinding Background}" CornerRadius="6" Height="48" Padding="14,0">
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="自动更新" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold"/>
                                                            <TextBlock Text="启动时自动检查新版本" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ItemBg" Property="Background" Value="#1AFFFFFF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <!-- 暂停更新（不影响手动检查更新） -->
                                        <Button Command="{Binding SetUpdateModeCommand}" CommandParameter="False"
                                                Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="ItemBg" Background="{TemplateBinding Background}" CornerRadius="6" Height="48" Padding="14,0">
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="暂停更新" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold"/>
                                                            <TextBlock Text="仅暂停自动检查，手动检查仍可用" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ItemBg" Property="Background" Value="#1AFFFFFF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>