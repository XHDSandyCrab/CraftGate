<UserControl x:Class="CraftGate.Views.AccountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CraftGate.Controls"
             xmlns:helpers="clr-namespace:CraftGate.Helpers">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <helpers:InverseBoolConverter x:Key="InvBool" />

        <!-- 通用：深色圆角按钮（hover 只变色，不模糊） -->
        <Style x:Key="SoftButton" TargetType="Button">
            <Setter Property="Background" Value="#2D3036"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="8"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#3A4048"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#25292E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 透明点击区按钮：铺满单元格、命中可靠 -->
        <Style x:Key="TransparentHitButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 弹窗卡片：平滑弹出（缩放+淡入） -->
        <Style x:Key="ModalCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#1E2025"/>
            <Setter Property="BorderBrush" Value="#33363E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value><ScaleTransform ScaleX="0.92" ScaleY="0.92"/></Setter.Value>
            </Setter>
            <Setter Property="Opacity" Value="0"/>
            <Style.Triggers>
                <!-- 绑定父遮罩 Grid 的 Visibility，每次打开都重播弹出动画 -->
                <DataTrigger Binding="{Binding Visibility, RelativeSource={RelativeSource AncestorType=Grid}}" Value="Visible">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.22">
                                    <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.22">
                                    <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 遮罩：淡入 -->
        <Style x:Key="ModalOverlayStyle" TargetType="Grid">
            <Setter Property="Opacity" Value="0"/>
            <Style.Triggers>
                <Trigger Property="Visibility" Value="Visible">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 单选勾选框：正方形圆角 + 主题色 + 点击灰色扩散(ripple) -->
        <Style x:Key="AccountRadioCheck" TargetType="CheckBox" BasedOn="{StaticResource AppCheckBoxStyle}">
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <!-- 账户列表项 -->
        <Style x:Key="AccountCard" TargetType="Border">
            <Setter Property="Background" Value="#24272D"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#33363E"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2E323A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="40">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="1.15*"/>
        </Grid.ColumnDefinitions>

        <!-- 主内容层（仅删除确认时平滑模糊）-->
        <Grid Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1.15*"/>
            </Grid.ColumnDefinitions>
            <Grid.Effect>
                <BlurEffect Radius="0"/>
            </Grid.Effect>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding BlurBackground}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(BlurEffect.Radius)" To="8" Duration="0:0:0.25">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(BlurEffect.Radius)" To="0" Duration="0:0:0.25">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

        <!-- ============ 左侧：账户列表 / 创建入口 ============ -->
        <Border Margin="0,0,20,0" Padding="28" Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="账户" FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,20"/>

                <!-- 有账户：账户列表 -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasAccount, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding Accounts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource AccountCard}" MouseLeftButtonUp="AccountCard_Click" Tag="{Binding Id}" Cursor="Hand">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- 头像：扁平皮肤大头（UV裁脸） -->
                                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8" Background="#1E2025" ClipToBounds="True">
                                            <Grid>
                                                <Image Source="{Binding HeadImage}" Width="44" Height="44" Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                       Visibility="{Binding IsMicrosoft, Converter={StaticResource InvBool}}"/>
                                                <Image Source="pack://application:,,,/CraftGate;component/Assets/microsoft_logo.png" Width="34" Height="34"
                                                       Visibility="{Binding IsMicrosoft, Converter={StaticResource BoolToVis}}"/>
                                            </Grid>
                                        </Border>
                                        <!-- 名字 + 类型 -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding Username}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding TypeLabel}" FontSize="11" Foreground="{StaticResource AccentBrush}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <!-- 悬浮删除叉叉：右上角，圆形背景，鼠标悬浮才浮现 -->
                                        <Button Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Width="22" Height="22" Margin="0,-8,-8,0" Cursor="Hand"
                                                ToolTip="删除账户"
                                                Command="{Binding DataContext.DeleteAccountCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Id}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="CloseBg" Width="20" Height="20" CornerRadius="10"
                                                            Background="#C0392B" BorderBrush="#E74C3C" BorderThickness="1">
                                                        <TextBlock Text="✕" FontSize="11" Foreground="White" FontWeight="Bold"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="CloseBg" Property="Background" Value="#E74C3C"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Opacity" Value="0"/>
                                                    <Style.Triggers>
                                                        <!-- 只有鼠标移到右上角叉叉区域才浮现 -->
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Opacity" Value="1"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <!-- 单选勾选框：卡片左上角，叠在头像角上；勾选=切换为当前账户 -->
                                        <CheckBox Grid.Column="0" Style="{StaticResource AccountRadioCheck}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  Command="{Binding DataContext.SelectAccountCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                  CommandParameter="{Binding Id}"
                                                  ToolTip="设为当前账户"
                                                  Panel.ZIndex="1"
                                                  HorizontalAlignment="Left" VerticalAlignment="Top"
                                                  Margin="-4,-4,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 无账户：大的创建入口 -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding HasAccount, Converter={StaticResource InvBool}}">
                    <Border Width="120" Height="120" CornerRadius="60" Background="#2D3036" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2"
                            HorizontalAlignment="Center">
                        <TextBlock Text="+" FontSize="72" FontWeight="Light" Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,8"/>
                    </Border>
                    <TextBlock Text="还没有账户" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" Margin="0,20,0,6"/>
                    <TextBlock Text="创建一个账户开始游戏" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                    <Button Content="创建账户" Command="{Binding OpenCreateWindowCommand}"
                            Style="{StaticResource SoftButton}" Width="160" Height="42" FontSize="14" FontWeight="Bold"
                            Margin="0,24,0,0" Background="{StaticResource AccentBrush}" Foreground="#0E2419"/>
                </StackPanel>

                <!-- 有账户时底部也有创建按钮 -->
                <Button Grid.Row="2" Content="+ 创建新账户" Command="{Binding OpenCreateWindowCommand}"
                        Style="{StaticResource SoftButton}" Height="42" FontSize="13"
                        Visibility="{Binding HasAccount, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Border>

        <!-- ============ 右侧：当前账户详情 + 皮肤预览 ============ -->
        <Border Style="{StaticResource CardStyle}" Grid.Column="1">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,16">
                    <TextBlock Text="账户详情" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <Border Background="#2D3036" CornerRadius="12" Padding="10,4" Margin="14,0,0,0" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasAccount}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding AccountTypeText}" FontSize="12" Foreground="{StaticResource AccentBrush}"/>
                    </Border>
                </StackPanel>

                <!-- 没有账户时的占位提示 -->
                <TextBlock Grid.Row="1" Text="还没有账户，请先在左侧创建一个" FontSize="14"
                           Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasAccount}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- 皮肤 3D 预览（站立动画）-->
                <controls:SkinPreview3D Grid.Row="1" Skin="{Binding SkinImage}" Cape="{Binding CurrentCapeImage}"
                                        AutoActivate="True" Animate="True" HorizontalAlignment="Center"
                                        Width="380" Height="520" MinHeight="360">
                    <controls:SkinPreview3D.Style>
                        <Style TargetType="controls:SkinPreview3D">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasAccount}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </controls:SkinPreview3D.Style>
                </controls:SkinPreview3D>

                <!-- 皮肤加载中提示 -->
                <TextBlock Grid.Row="1" Text="正在加载皮肤..." FontSize="13" Foreground="{StaticResource AccentBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoadingSkinModal}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasAccount}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- 玩家名称（只显示，不编辑）-->
                <TextBlock Grid.Row="2" Text="{Binding PlayerName}" FontSize="16" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,8,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasAccount}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
        </Grid><!-- /主内容层 -->

        <!-- ============ 创建账户：选择弹窗（两个方块） ============ -->
        <Grid Grid.ColumnSpan="2" Background="#99000000" Style="{StaticResource ModalOverlayStyle}"
              Visibility="{Binding IsCreateWindowVisible, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource ModalCardStyle}" Width="560" Padding="32" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="创建账户" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="选择登录方式" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,28"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 正版登录方块 -->
                        <Border Grid.Column="0" Background="#24272D" CornerRadius="12" BorderThickness="2" BorderBrush="#33363E" Padding="20">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="80" Height="80" CornerRadius="12" Background="#1E2025" HorizontalAlignment="Center">
                                    <Image Source="pack://application:,,,/CraftGate;component/Assets/microsoft_logo.png" Width="56" Height="56"/>
                                </Border>
                                <TextBlock Text="正版登录" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center" Margin="0,16,0,6"/>
                                <TextBlock Text="微软账号 · 需 Client ID" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" TextWrapping="Wrap" Height="30" Margin="0,0,0,18"/>
                                <Button Content="登录" Command="{Binding StartMicrosoftCommand}" Style="{StaticResource SoftButton}"
                                        Background="{StaticResource AccentBrush}" Foreground="#0E2419"
                                        Width="120" Height="38" FontSize="13" FontWeight="Bold" Margin="0,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- 离线登录方块 -->
                        <Border Grid.Column="2" Background="#24272D" CornerRadius="12" BorderThickness="2" BorderBrush="#33363E" Padding="20">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="80" Height="80" CornerRadius="12" Background="#1E2025" HorizontalAlignment="Center">
                                    <Image Source="pack://application:,,,/CraftGate;component/Assets/steve_head.png" Width="72" Height="72"/>
                                </Border>
                                <TextBlock Text="离线登录" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center" Margin="0,16,0,6"/>
                                <TextBlock Text="无需账号 · 创建后编辑" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" TextWrapping="Wrap" Height="30" Margin="0,0,0,18"/>
                                <Button Content="创建" Command="{Binding CreateOfflineCommand}" Style="{StaticResource SoftButton}"
                                        Background="{StaticResource AccentBrush}" Foreground="#0E2419"
                                        Width="120" Height="38" FontSize="13" FontWeight="Bold" Margin="0,0,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Button Content="取消" Command="{Binding CloseCreateWindowCommand}" Style="{StaticResource SoftButton}"
                            Width="100" Height="36" Margin="0,24,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>


        <!-- ============ 设备码登录弹窗（PCL 风格） ============ -->
        <Grid Grid.ColumnSpan="2" Background="#99000000" Style="{StaticResource ModalOverlayStyle}"
              Visibility="{Binding IsDeviceLoginVisible, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource ModalCardStyle}" Width="460" Padding="32" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="微软正版登录" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding LoginStatus}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,20"/>
                    <TextBlock Text="你的验证码" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <Border Background="#1E2025" CornerRadius="8" Padding="16" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Margin="0,0,0,16">
                        <TextBlock Text="{Binding DeviceCode}" FontSize="28" FontWeight="Bold" FontFamily="Consolas"
                                   Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="打开下面的网址，登录后输入这串验证码：" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding VerifyUri, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource DarkTextBoxStyle}" Height="34" VerticalContentAlignment="Center" Margin="0,0,0,16"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="复制验证码" Command="{Binding CopyCodeCommand}" Width="110" Height="36" Margin="0,0,10,0"
                                Background="#2D3036" Foreground="{StaticResource TextPrimaryBrush}" Style="{StaticResource SoftButton}"/>
                        <Button Content="取消" Command="{Binding CancelLoginCommand}" Width="80" Height="36"
                                Background="#2D3036" Foreground="{StaticResource TextPrimaryBrush}" Style="{StaticResource SoftButton}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ 应用内提示弹窗（圆角，替代系统MessageBox） ============ -->
        <Grid Grid.ColumnSpan="2" Background="#B3000000" Style="{StaticResource ModalOverlayStyle}"
              Visibility="{Binding IsNoticeVisible, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource ModalCardStyle}" Width="440" Padding="28" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding NoticeTitle}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                    <TextBlock Text="{Binding NoticeMessage}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" LineHeight="22" Margin="0,0,0,24"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="取消" Command="{Binding CloseNoticeCommand}" Style="{StaticResource SoftButton}"
                                Width="90" Height="36" Margin="0,0,10,0"
                                Visibility="{Binding IsNoticeConfirm, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="确定" Command="{Binding ConfirmNoticeCommand}" Style="{StaticResource SoftButton}"
                                Width="90" Height="36" Background="{StaticResource AccentBrush}" Foreground="#0E2419"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
