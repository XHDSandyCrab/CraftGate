<UserControl x:Class="CraftGate.Views.DownloadCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#15161A">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="#1E2025" Padding="30,20" BorderBrush="#2A2D34" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnBack" Click="BtnBack_Click" Width="36" Height="36" Margin="0,0,16,0" Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="18">
                                        <TextBlock Text="&#xE72B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#1AFFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <TextBlock Text="下载任务中心" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding OverallSpeed}" HorizontalAlignment="Right" Foreground="#3DDC84" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                </Grid>

                <!-- 总进度条 -->
                <ProgressBar Grid.Row="1" Height="8" Margin="0,15,0,5" Value="{Binding OverallProgress}" Background="#2B2E35" Foreground="#3DDC84" BorderThickness="0" Maximum="100">
                    <ProgressBar.Template>
                        <ControlTemplate TargetType="ProgressBar">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                <Grid>
                                    <Border x:Name="PART_Track" Background="Transparent" />
                                    <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="4" HorizontalAlignment="Left" />
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </ProgressBar.Template>
                </ProgressBar>

                <Grid Grid.Row="2">
                    <TextBlock Text="总进度" Foreground="#9BA1A8" FontSize="12"/>
                    <TextBlock Text="{Binding OverallProgress, StringFormat={}{0:F1}%}" Foreground="#3DDC84" FontWeight="Bold" HorizontalAlignment="Right" FontSize="12"/>
                </Grid>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="30">
            <ItemsControl ItemsSource="{Binding CategoryGroups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,30">
                            <TextBlock Text="{Binding TitleText}" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,15"/>

                            <ItemsControl ItemsSource="{Binding Tasks}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,15,15" Cursor="Hand" 
                                                Click="Card_Click" Tag="&#xE896;">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bg" Background="#1E2025" BorderBrush="#2A2D34" BorderThickness="2" CornerRadius="8" ClipToBounds="True">
                                                        <Grid>
                                                            <Grid x:Name="CardContent" Margin="15">
                                                                <Grid.Effect>
                                                                    <BlurEffect Radius="0"/>
                                                                </Grid.Effect>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>

                                                                <Grid Grid.Row="0">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" Text="{Binding DisplayFileName}" Foreground="White" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" FontSize="13" Margin="0,0,10,0"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding SpeedText}" Foreground="#3DDC84" FontSize="11" VerticalAlignment="Center"/>
                                                                </Grid>

                                                                <!-- 👇 重构：分离正常进度条与排队动画，杜绝解析崩溃 -->
                                                                <Grid Grid.Row="1" Height="8" Margin="0,12,0,8" Background="#15161A" ClipToBounds="True">
                                                                    <Grid.Resources>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="CornerRadius" Value="4"/>
                                                                        </Style>
                                                                    </Grid.Resources>

                                                                    <!-- 1. 正常下载态 (IsWaiting 为 False 时显示) -->
                                                                    <ProgressBar Value="{Binding DisplayProgress}" Background="Transparent" Foreground="#3DDC84" BorderThickness="0" Maximum="100">
                                                                        <ProgressBar.Style>
                                                                            <Style TargetType="ProgressBar">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsWaiting}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </ProgressBar.Style>
                                                                        <ProgressBar.Template>
                                                                            <ControlTemplate TargetType="ProgressBar">
                                                                                <Grid>
                                                                                    <Border x:Name="PART_Track" Background="Transparent" />
                                                                                    <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="4" HorizontalAlignment="Left" />
                                                                                </Grid>
                                                                            </ControlTemplate>
                                                                        </ProgressBar.Template>
                                                                    </ProgressBar>

                                                                    <!-- 2. 等待排队动画 (IsWaiting 为 True 时显示) -->
                                                                    <Border Background="Transparent">
                                                                        <Border.Style>
                                                                            <Style TargetType="Border">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsWaiting}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>

                                                                        <!-- 等待指示短条（移除滚动动画：模板内静态 TranslateTransform 被冻结，
                                                                             对 (RenderTransform).(TranslateTransform.X) 做动画会在布局期抛
                                                                             "无法对不可变对象(0).(1)进行动画处理"） -->
                                                                        <Border x:Name="WaitingBar" Width="40" Background="#3DDC84" CornerRadius="4" HorizontalAlignment="Left"/>
                                                                    </Border>
                                                                </Grid>

                                                                <TextBlock Grid.Row="2" Text="{Binding DisplayProgress, StringFormat={}{0:F1}%}" Foreground="#6A6F77" FontSize="11" HorizontalAlignment="Right"/>
                                                            </Grid>

                                                            <TextBlock x:Name="HoverIcon" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" 
                                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="32" 
                                                                       Foreground="#3DDC84" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <EventTrigger RoutedEvent="MouseEnter">
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="CardContent" Storyboard.TargetProperty="(UIElement.Effect).(BlurEffect.Radius)" To="5" Duration="0:0:0.2"/>
                                                                    <DoubleAnimation Storyboard.TargetName="HoverIcon" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </EventTrigger>
                                                        <EventTrigger RoutedEvent="MouseLeave">
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="CardContent" Storyboard.TargetProperty="(UIElement.Effect).(BlurEffect.Radius)" To="0" Duration="0:0:0.2"/>
                                                                    <DoubleAnimation Storyboard.TargetName="HoverIcon" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </EventTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bg" Property="BorderBrush" Value="#3DDC84"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid x:Name="DetailModal" Grid.RowSpan="2" Visibility="Collapsed">
            <Border x:Name="ModalBg" Background="#AA000000" Opacity="0" MouseLeftButtonDown="ModalBg_Click"/>
            <Border x:Name="ModalContent" Background="#1E2025" Width="500" CornerRadius="12" BorderBrush="#2A2D34" BorderThickness="1" VerticalAlignment="Center" HorizontalAlignment="Center" MouseLeftButtonDown="ModalContent_Click" Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="0.9" ScaleY="0.9"/>
                </Border.RenderTransform>
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="下载详情" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,0,0,20"/>

                    <StackPanel Grid.Row="1" Margin="0,0,0,15">
                        <TextBlock Text="文件名" Foreground="#9BA1A8" FontSize="12" Margin="0,0,0,4"/>
                        <TextBlock x:Name="TxtFileName" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0,0,0,15">
                        <TextBlock Text="下载网址" Foreground="#9BA1A8" FontSize="12" Margin="0,0,0,4"/>
                        <Border Background="#15161A" CornerRadius="6" Padding="10">
                            <TextBlock x:Name="TxtUrl" Foreground="#3DDC84" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Margin="0,0,0,20">
                        <TextBlock Text="本地存储路径" Foreground="#9BA1A8" FontSize="12" Margin="0,0,0,4"/>
                        <Border Background="#15161A" CornerRadius="6" Padding="10">
                            <TextBlock x:Name="TxtPath" Foreground="#9BA1A8" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"/>
                        </Border>
                    </StackPanel>

                    <Grid Grid.Row="4">
                        <Button Content="复制网址" Click="BtnCopyUrl_Click" Width="110" Height="36" 
                                Background="#2B2E35" Foreground="White" 
                                Style="{StaticResource HoverIconButtonStyle}" Tag="&#xE8C8;">
                            <Button.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="White"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button Content="关闭" Click="BtnCloseModal_Click" HorizontalAlignment="Right" Width="100" Height="36" 
                                Background="#3DDC84" Foreground="#0E2419" FontWeight="Bold"
                                Style="{StaticResource HoverIconButtonStyle}" Tag="&#xE711;">
                            <Button.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#0E2419"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
