<UserControl x:Class="CraftGate.Views.ToastNotification"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="340">
    <UserControl.RenderTransform>
        <TranslateTransform x:Name="SlideTransform" X="400" />
    </UserControl.RenderTransform>

    <!-- 最外层：完全透明但强制裁剪圆角（Background="#01000000" 为了触发 WPF 的裁剪机制） -->
    <Border Background="#01000000" CornerRadius="{StaticResource CardCornerRadius}" ClipToBounds="True">
        <Grid>
            <!-- 阴影改放外层 Border，避免 Grid.Effect 干扰圆角裁剪（原来放这里导致进度条在卡片左上角漏出绿点） -->

            <!-- 尺寸参照层：占满整个卡片，尺寸稳定不依赖子元素，供遮罩绑定（避免循环依赖） -->
            <Grid x:Name="ProgressArea"/>

            <!-- 进度层外套：用 OpacityMask 把进度槽+进度条裁成卡片圆角，右端再也不会超出 -->
            <Grid>
                <Grid.OpacityMask>
                    <VisualBrush Stretch="None" AlignmentX="Left" AlignmentY="Top">
                        <VisualBrush.Visual>
                            <Border Background="White" CornerRadius="{StaticResource CardCornerRadius}"
                                    Width="{Binding ActualWidth, ElementName=ProgressArea}"
                                    Height="{Binding ActualHeight, ElementName=ProgressArea}"/>
                        </VisualBrush.Visual>
                    </VisualBrush>
                </Grid.OpacityMask>

                <!-- 底层：浅绿色进度槽 -->
                <Border Background="#2A4A3A" CornerRadius="{StaticResource CardCornerRadius}" />

                <!-- 进度条本体：默认左端圆角贴合卡片、右端直线（进度头）；填满时由代码切换成两端圆角 -->
                <Border x:Name="ProgressFill" Background="{StaticResource AccentBrush}" HorizontalAlignment="Left"
                        Width="0" CornerRadius="8,0,0,8"/>
            </Grid>

            <!-- 👇 顶层：黑色内容卡片。
                 留出底部 8px 漏出进度条。
                 关键：必须带上全局圆角，否则顶部的两个角会变成直角！ -->
            <Border Background="#2C2E33" CornerRadius="{StaticResource CardCornerRadius}" Margin="0,0,0,8">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 图标 -->
                    <TextBlock x:Name="TxtIcon" Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" 
                               FontSize="20" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Top" Margin="0,2,0,0"/>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock x:Name="TxtTitle" Text="下载任务" Foreground="White" FontSize="14" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtMessage" Text="正在准备下载..." Foreground="#9BA1A8" FontSize="12" Margin="0,4,0,0" 
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>