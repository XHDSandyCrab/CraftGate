<UserControl x:Class="CraftGate.Views.DownloadListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:helpers="clr-namespace:CraftGate.Helpers">
    <UserControl.Resources>
        <!-- 分类按钮样式 -->
        <Style x:Key="CategoryButtonStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="#1AFFFFFF" CornerRadius="16" Padding="16,8"
                                BorderBrush="Transparent" BorderThickness="2"
                                helpers:BorderTraceBehavior.Enabled="True">
                            <TextBlock x:Name="Txt" Text="{TemplateBinding Content}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" FontWeight="SemiBold" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2DFFFFFF"/>
                                <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Txt" Property="Foreground" Value="#0E2419"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border Style="{StaticResource CardStyle}" Margin="40">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 标题区 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <TextBlock Text="游戏版本下载" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text=" (自动缓存)" FontSize="14" VerticalAlignment="Bottom" Margin="8,0,0,2" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>

                <!-- 👇 分类选项卡 -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,20">
                    <RadioButton Content="正式版" Style="{StaticResource CategoryButtonStyle}" IsChecked="True"
                                 Command="{Binding FilterCommand}" CommandParameter="release"/>
                    <RadioButton Content="快照版" Style="{StaticResource CategoryButtonStyle}"
                                 Command="{Binding FilterCommand}" CommandParameter="snapshot"/>
                    <RadioButton Content="远古版" Style="{StaticResource CategoryButtonStyle}"
                                 Command="{Binding FilterCommand}" CommandParameter="old"/>
                    <RadioButton Content="愚人节版" Style="{StaticResource CategoryButtonStyle}"
                                 Command="{Binding FilterCommand}" CommandParameter="april_fools"/>
                </StackPanel>

                <!-- 列表区 -->
                <Grid Grid.Row="2">
                    <!-- Loading -->
                    <TextBlock Text="正在获取版本列表..." Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ListBox x:Name="VersionList" ItemsSource="{Binding Versions}" Background="Transparent" BorderThickness="0" 
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False"
                             PreviewMouseWheel="VersionList_PreviewMouseWheel"
                             helpers:StaggerPanel.Enabled="True"
                             helpers:StaggerPanel.ItemDelay="0:0:0.045"
                             helpers:StaggerPanel.ShiftY="14">
                        <ListBox.Style>
                            <Style TargetType="ListBox">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Style>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#0AFFFFFF" BorderThickness="2"
                                        CornerRadius="6" Height="64" Margin="0,0,0,8" Cursor="Hand"
                                        ClipToBounds="True" MouseLeftButtonUp="Card_MouseLeftButtonUp">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid>
                                        <Grid x:Name="CardContent">
                                            <Grid.Effect><BlurEffect Radius="0"/></Grid.Effect>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Background="#14FFFFFF" CornerRadius="6,0,0,6" Padding="12">
                                                <!-- 版本类型图标：原版/远古=草方块，快照/愚人节=命令方块 -->
                                                <Image Source="{Binding IconPath}" Width="36" Height="36" Stretch="Uniform"/>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                                                <TextBlock Text="{Binding Id}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding Time, StringFormat='{}{0:yyyy-MM-dd}'}" FontSize="12" Margin="0,2,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </StackPanel>

                                        </Grid>
                                        <TextBlock x:Name="HoverIcon" Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="30" Foreground="{StaticResource AccentBrush}" Opacity="0"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                    </Grid>

                                    <Border.Triggers>
                                        <EventTrigger RoutedEvent="MouseEnter">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="CardContent" Storyboard.TargetProperty="(UIElement.Effect).(BlurEffect.Radius)" To="6" Duration="0:0:0.2" FillBehavior="HoldEnd"/>
                                                    <DoubleAnimation Storyboard.TargetName="HoverIcon" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" FillBehavior="HoldEnd"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                        <EventTrigger RoutedEvent="MouseLeave">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="CardContent" Storyboard.TargetProperty="(UIElement.Effect).(BlurEffect.Radius)" To="0" Duration="0:0:0.2" FillBehavior="HoldEnd"/>
                                                    <DoubleAnimation Storyboard.TargetName="HoverIcon" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" FillBehavior="HoldEnd"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Border.Triggers>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
