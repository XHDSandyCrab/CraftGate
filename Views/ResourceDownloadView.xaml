<UserControl x:Class="CraftGate.Views.ResourceDownloadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:CraftGate.Helpers">
    <UserControl.Resources>
        <!-- 选项卡胶囊样式 -->
        <Style x:Key="CategoryTabStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="#1AFFFFFF" CornerRadius="16" Padding="16,8"
                                BorderBrush="Transparent" BorderThickness="2"
                                helpers:BorderTraceBehavior.Enabled="True">
                            <TextBlock x:Name="Txt" Text="{TemplateBinding Content}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" FontWeight="SemiBold" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2DFFFFFF"/>
                                <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Txt" Property="Foreground" Value="#0E2419"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 现代圆角勾选框 -->
        <Style x:Key="ModernCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource AppCheckBoxStyle}"/>

        <!-- 平滑手风琴 -->
        <Style TargetType="Expander">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ToggleButton x:Name="HeaderSite" Content="{TemplateBinding Header}" IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="#1AFFFFFF" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" FontSize="14" Padding="16,12" Cursor="Hand" Margin="0,0,0,8"
                                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8"
                                                BorderThickness="2" helpers:BorderTraceBehavior.Enabled="True">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="Arrow" Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Arrow" Property="Text" Value="&#xE70E;"/>
                                                <Setter TargetName="Arrow" Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Border Grid.Row="1" Margin="0,8,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <ContentPresenter />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <!-- 版本组卡片模板（兼容/其他两块共用） -->
        <DataTemplate x:Key="VersionGroupTemplate">
            <Expander Header="{Binding GameVersion}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                <ItemsControl ItemsSource="{Binding Versions}"
                              helpers:StaggerPanel.Enabled="True"
                              helpers:StaggerPanel.ItemDelay="0:0:0.04"
                              helpers:StaggerPanel.ShiftY="12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- 效果1：描边闪现（瞬间变色）+ 内容高斯模糊 + 下载图标居中淡入 -->
                            <Border Background="#0AFFFFFF" BorderThickness="2" CornerRadius="6" Margin="0,0,0,10" Padding="14,12" MinHeight="56" Cursor="Hand"
                                    ClipToBounds="True" MouseLeftButtonUp="VersionItem_MouseLeftButtonUp">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid x:Name="CardContent">
                                        <Grid.Effect><BlurEffect Radius="0"/></Grid.Effect>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding VersionNumber}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" LineHeight="20"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <Border Background="#1F3DDC84" CornerRadius="4" Padding="4,2" Margin="0,0,8,0">
                                                    <!-- 显示所属分组的 MC 版本（不是 GameVersions[0]，否则 1.21.8 条目会标成 1.21.6） -->
                                                    <TextBlock FontSize="10" Foreground="{StaticResource AccentBrush}" LineHeight="14">
                                                        <TextBlock.Text>
                                                            <Binding RelativeSource="{RelativeSource AncestorType=Expander}" Path="Header"/>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </Border>
                                                <TextBlock Text="{Binding Loaders[0]}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" LineHeight="14"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock x:Name="HoverIcon" Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="30" Foreground="{StaticResource AccentBrush}" Opacity="0"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                </Grid>
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="MouseEnter">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="CardContent" Storyboard.TargetProperty="(UIElement.Effect).(BlurEffect.Radius)" To="6" Duration="0:0:0.2" FillBehavior="HoldEnd"/>
                                                <DoubleAnimation Storyboard.TargetName="HoverIcon" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" FillBehavior="HoldEnd"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="MouseLeave">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="CardContent" Storyboard.TargetProperty="(UIElement.Effect).(BlurEffect.Radius)" To="0" Duration="0:0:0.2" FillBehavior="HoldEnd"/>
                                                <DoubleAnimation Storyboard.TargetName="HoverIcon" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" FillBehavior="HoldEnd"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>
        </DataTemplate>

        <!-- 弹窗按钮特效 -->
        <Style x:Key="HoverIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1AFFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="2" CornerRadius="8" ClipToBounds="True">
                            <Grid>
                                <Grid x:Name="CardContent">
                                    <Grid.Effect>
                                        <BlurEffect Radius="0"/>
                                    </Grid.Effect>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,0"/>
                                </Grid>
                                <TextBlock x:Name="HoverIcon" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" 
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" 
                                           Foreground="{TemplateBinding Foreground}" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CardContent" Storyboard.TargetProperty="(UIElement.Effect).(BlurEffect.Radius)" To="5" Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetName="HoverIcon" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CardContent" Storyboard.TargetProperty="(UIElement.Effect).(BlurEffect.Radius)" To="0" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="HoverIcon" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="40">
        <Border Style="{StaticResource CardStyle}" Padding="24" ClipToBounds="True">
            <Grid>
                <!-- ==================== 主搜索界面 ==================== -->
                <Grid x:Name="MainSearchGrid">
                    <Grid.RenderTransform>
                        <TranslateTransform X="0"/>
                    </Grid.RenderTransform>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsVersionSelectVisible}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="模组与光影下载 (Modrinth)" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>

                    <Grid Grid.Row="1" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton Content="Mod" IsChecked="True" Style="{StaticResource CategoryTabStyle}" Command="{Binding FilterCommand}" CommandParameter="mod"/>
                            <RadioButton Content="光影" Style="{StaticResource CategoryTabStyle}" Command="{Binding FilterCommand}" CommandParameter="shader"/>
                            <RadioButton Content="数据包" Style="{StaticResource CategoryTabStyle}" Command="{Binding FilterCommand}" CommandParameter="datapack"/>
                            <RadioButton Content="整合包" Style="{StaticResource CategoryTabStyle}" Command="{Binding FilterCommand}" CommandParameter="modpack"/>
                            <RadioButton Content="资源包" Style="{StaticResource CategoryTabStyle}" Command="{Binding FilterCommand}" CommandParameter="resourcepack"/>
                        </StackPanel>

                        <!-- 胶囊搜索框 -->
                        <Border Grid.Column="1" Margin="24,0,0,0" CornerRadius="20" Background="#1AFFFFFF" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0">
                                    <TextBox x:Name="SearchBox" 
                                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                             Height="40" 
                                             VerticalContentAlignment="Center"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="White"
                                             CaretBrush="{StaticResource AccentBrush}"
                                             Padding="16,0,0,0"
                                             KeyDown="SearchBox_KeyDown" />

                                    <TextBlock x:Name="Placeholder" 
                                               Text="支持中文搜索（如 钠、机械动力）..." 
                                               Foreground="#6A6F77" 
                                               Margin="16,0,0,0" 
                                               VerticalAlignment="Center" 
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <Button Grid.Column="1" Command="{Binding SearchCommand}" Width="48" Height="40" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="0,20,20,0">
                                                <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#2DFFFFFF"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Background" Value="#1AFFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>

                    <TextBlock Grid.Row="2" Text="{Binding StatusText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,16"/>

                    <ListBox x:Name="ResultList" Grid.Row="3" ItemsSource="{Binding Results}" Background="Transparent" BorderThickness="0" 
                             ScrollViewer.CanContentScroll="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled" 
                             VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling"
                             PreviewMouseWheel="ResultList_PreviewMouseWheel">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,12,10">
                                    <Border x:Name="CardBorder" BorderThickness="2" BorderBrush="Transparent" CornerRadius="8" />

                                    <Border x:Name="CardBg" Background="#1AFFFFFF" CornerRadius="6" Margin="2" ClipToBounds="True">
                                        <Grid x:Name="CardContent" MouseLeftButtonUp="CardContent_MouseLeftButtonUp" Cursor="Hand" Background="Transparent">
                                            <Grid.Effect>
                                                <BlurEffect Radius="0"/>
                                            </Grid.Effect>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="96"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="160"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Background="#2A2D34" Width="80" Height="80" CornerRadius="6" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="8,0,0,0">
                                                <Image Source="{Binding IconImage}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="LowQuality">
                                                    <Image.Clip>
                                                        <RectangleGeometry Rect="0,0,80,80" RadiusX="6" RadiusY="6"/>
                                                    </Image.Clip>
                                                </Image>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,16,0">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding Description}" FontSize="12" Margin="0,4,0,0" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34"/>
                                                <TextBlock Text="{Binding Author, StringFormat='作者: {0}'}" FontSize="11" Foreground="{StaticResource AccentBrush}" Margin="0,4,0,0"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="2" Text="{Binding Downloads, StringFormat='下载量: {0}'}" 
                                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0"/>
                                        </Grid>
                                    </Border>

                                    <TextBlock x:Name="HoverDownloadIcon" Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" 
                                               FontSize="32" Foreground="{StaticResource AccentBrush}" Opacity="0"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                </Grid>

                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=CardContent}" Value="True">
                                        <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                        <Setter TargetName="CardBg" Property="Background" Value="#2DFFFFFF"/>
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="CardContent" Storyboard.TargetProperty="(UIElement.Effect).(BlurEffect.Radius)" To="8" Duration="0:0:0.25"/>
                                                    <DoubleAnimation Storyboard.TargetName="HoverDownloadIcon" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="CardContent" Storyboard.TargetProperty="(UIElement.Effect).(BlurEffect.Radius)" To="0" Duration="0:0:0.2"/>
                                                    <DoubleAnimation Storyboard.TargetName="HoverDownloadIcon" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <!-- ==================== 独立版本选择界面 ==================== -->
                <Grid x:Name="VersionSelectGrid">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsVersionSelectVisible}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>


                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Command="{Binding CloseVersionPageCommand}" Cursor="Hand" Width="36" Height="36" Margin="0,0,16,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="#1AFFFFFF" CornerRadius="18">
                                        <TextBlock Text="&#xE72B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#2DFFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <TextBlock Grid.Column="1" Text="{Binding PopupTitle}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!-- 兼容版本为空时的提示 -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CompatibleGroups.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="该资源没有兼容你已安装版本的版本" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,10,0,16" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- 兼容版本 -->
                            <StackPanel Margin="0,0,0,8">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CompatibleGroups.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="兼容版本" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,10"/>
                                <ItemsControl ItemsSource="{Binding CompatibleGroups}" ItemTemplate="{StaticResource VersionGroupTemplate}"/>
                            </StackPanel>

                            <!-- 其他版本 -->
                            <StackPanel Margin="0,16,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding OtherGroups.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="其他版本" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10"/>
                                <ItemsControl ItemsSource="{Binding OtherGroups}" ItemTemplate="{StaticResource VersionGroupTemplate}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ==================== 依赖/下载确认弹窗 ==================== -->
                <Grid Background="#AA000000" Margin="-24">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDependencyPopupVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Border Background="{StaticResource CardBackgroundBrush}" Width="460" MaxHeight="600" CornerRadius="12" VerticalAlignment="Center" HorizontalAlignment="Center" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                        <Grid Margin="24">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="确认下载列表" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Text="包含主模组及其前置依赖，取消勾选可能导致游戏崩溃：" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,20"/>

                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,20">
                                <ItemsControl ItemsSource="{Binding DownloadConfirmationList}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#1AFFFFFF" CornerRadius="8" Margin="0,0,0,10" Padding="16">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- 已安装则不显示勾选框 -->
                                                    <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,16,0">
                                                        <CheckBox.Style>
                                                            <Style TargetType="CheckBox" BasedOn="{StaticResource ModernCheckBoxStyle}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </CheckBox.Style>
                                                    </CheckBox>

                                                    <Grid Grid.Column="1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Border Width="40" Height="40" CornerRadius="6" Background="#2A2D34" VerticalAlignment="Center" Margin="0,0,16,0">
                                                            <Image Source="{Binding ProjectInfo.IconImage}" Stretch="UniformToFill">
                                                                <Image.Clip>
                                                                    <RectangleGeometry Rect="0,0,40,40" RadiusX="6" RadiusY="6"/>
                                                                </Image.Clip>
                                                            </Image>
                                                        </Border>

                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding ProjectInfo.DisplayName}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                                                                <Border Background="#1F3DDC84" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsMainMod}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock Text="主模组" FontSize="10" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/>
                                                                </Border>
                                                                <!-- 已安装标记：替代勾选框，明确告诉用户不用再下 -->
                                                                <Border Background="#223DDC84" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock Text="已下载" FontSize="10" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding VersionInfo.VersionNumber, StringFormat='版本: {0}'}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <Grid Grid.Row="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button Command="{Binding ToggleAllDependenciesCommand}" Background="#1AFFFFFF" Cursor="Hand" Padding="12,6" HorizontalAlignment="Left" Style="{StaticResource HoverIconButtonStyle}" Tag="&#xE73E;">
                                    <TextBlock Text="全选 / 反选" FontSize="12"/>
                                </Button>

                                <Button Grid.Column="1" Content="取消" Command="{Binding CloseDependencyPopupCommand}" Width="80" Height="36" Margin="0,0,12,0" 
                                        Style="{StaticResource HoverIconButtonStyle}" Tag="&#xE711;"/>

                                <Button Grid.Column="2" Content="确认并下载" Command="{Binding ConfirmDependenciesCommand}" Width="120" Height="36" 
                                        Background="{StaticResource AccentBrush}" Foreground="#0E2419" FontWeight="Bold" 
                                        Style="{StaticResource HoverIconButtonStyle}" Tag="&#xE896;">
                                    <Button.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#0E2419"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
