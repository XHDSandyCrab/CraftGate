<UserControl x:Class="CraftGate.Views.DownloadDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:CraftGate.Helpers"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <helpers:InverseBoolConverter x:Key="InvBool" />

        <!-- 方块勾选框：统一全局样式（未勾深色 / 勾选主题绿） -->
        <Style x:Key="WizardCheck" TargetType="CheckBox" BasedOn="{StaticResource AppCheckBoxStyle}"/>

        <!-- 加载器方块：无黑底，悬浮用效果2(绿色描边从最近点发射) -->
        <DataTemplate x:Key="LoaderBlockTemplate">
            <Border x:Name="Card" Width="160" Height="160" Background="{StaticResource CardBackgroundBrush}" CornerRadius="12" Margin="0,0,16,16"
                    BorderThickness="2" BorderBrush="Transparent" helpers:BorderTraceBehavior.Enabled="True">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSupported}" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <!-- 右上角勾选框：原版(Minecraft)不显示，默认下载 -->
                    <CheckBox Style="{StaticResource WizardCheck}" IsChecked="{Binding IsChecked}"
                              IsEnabled="{Binding IsSupported}"
                              HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,8,0,0" Panel.ZIndex="2"
                              Visibility="{Binding IsVanilla, Converter={StaticResource InvBool}}"/>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10,0,0">
                        <!-- 图标底板：圆角浅色块 -->
                        <Border Background="#14FFFFFF" CornerRadius="10" Width="56" Height="56" HorizontalAlignment="Center">
                            <Image Source="{Binding IconPath}" Width="44" Height="44" Stretch="Uniform"/>
                        </Border>
                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                            <TextBlock Text="{Binding SelectedVersionText}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                                       MaxWidth="80" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <!-- 编辑版本笔：原版不显示 -->
                            <Button Command="{Binding OnEditVersionCommand}" CommandParameter="{Binding}"
                                    Width="18" Height="18" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="2,0,0,0"
                                    ToolTip="选择版本" IsEnabled="{Binding IsSupported}"
                                    Visibility="{Binding IsVanilla, Converter={StaticResource InvBool}}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="4" Background="#1AFFFFFF">
                                            <TextBlock Text="✎" FontSize="12" FontWeight="Bold"
                                                       Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 附带模块方块：无黑底，悬浮用效果2 -->
        <DataTemplate x:Key="ModuleBlockTemplate">
            <Border x:Name="Card" Width="160" Height="160" Background="{StaticResource CardBackgroundBrush}" CornerRadius="12" Margin="0,0,16,16"
                    BorderThickness="2" BorderBrush="Transparent" helpers:BorderTraceBehavior.Enabled="True">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <CheckBox Style="{StaticResource WizardCheck}" IsChecked="{Binding IsChecked}"
                              HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,8,0,0" Panel.ZIndex="2"/>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10,0,0">
                        <!-- 模块图标：本地 Assets，圆角底板，图标本身倒圆角、无边框 -->
                        <Border Background="#14FFFFFF" CornerRadius="12" Width="56" Height="56" HorizontalAlignment="Center">
                            <Image Source="{Binding IconPath}" Width="48" Height="48" Stretch="UniformToFill">
                                <Image.Clip>
                                    <RectangleGeometry Rect="0,0,48,48" RadiusX="10" RadiusY="10"/>
                                </Image.Clip>
                            </Image>
                        </Border>
                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                            <TextBlock Text="{Binding VersionText}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                                       MaxWidth="80" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <Button Command="{Binding OnEditVersionCommand}" CommandParameter="{Binding}"
                                    Width="18" Height="18" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="2,0,0,0"
                                    ToolTip="选择版本">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasVersionSelector}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="4" Background="#1AFFFFFF">
                                            <TextBlock Text="✎" FontSize="12" FontWeight="Bold"
                                                       Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid Margin="40,40,40,100">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 顶部 Header（版本页打开时隐藏，避免标题重影）-->
            <Border Style="{StaticResource CardStyle}" Padding="24" Margin="0,0,0,20"
                    Visibility="{Binding IsVersionPageOpen, Converter={StaticResource InvBool}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Click="BtnBack_Click" Width="40" Height="40" Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="20">
                                    <TextBlock Text="&#xE72B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1AFFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="创建游戏实例" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding VersionId, StringFormat='基于 Minecraft {0}'}" FontSize="12" Margin="0,3,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 向导内容 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsVersionPageOpen, Converter={StaticResource InvBool}}">
                <StackPanel>
                    <!-- 加载中 -->
                    <TextBlock Text="正在分析该版本支持的加载器与模块..." Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,60,0,0"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>

                    <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource InvBool}}">
                        <!-- ===== 1. 基本信息 ===== -->
                        <Border Style="{StaticResource CardStyle}" Padding="22" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="基本信息" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="选择实例图标与名称" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,14"/>

                                <ItemsControl x:Name="IconPanel" ItemsSource="{Binding IconOptions}" PreviewMouseLeftButtonUp="IconPanel_PreviewMouseLeftButtonUp">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding SelectCommand}" Width="56" Height="56" Margin="0,0,12,12"
                                                    Cursor="Hand" ToolTip="{Binding Name}" Background="Transparent" BorderThickness="0">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bg" Background="{StaticResource CardBackgroundBrush}" CornerRadius="10"
                                                                BorderThickness="2" BorderBrush="Transparent">
                                                            <Grid>
                                                                <Image Source="{Binding IconPath}" Width="36" Height="36" Stretch="Uniform"
                                                                       Visibility="{Binding IsBuiltin, Converter={StaticResource BoolToVis}}"/>
                                                                <Image Source="{Binding IconImage}" Width="40" Height="40" Stretch="Uniform"
                                                                       Visibility="{Binding IsBuiltin, Converter={StaticResource InvBool}}"/>
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                            </DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bg" Property="Background" Value="#2A2D34"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="实例名称：" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Text="{Binding InstanceName, UpdateSourceTrigger=PropertyChanged}" Width="260" Height="38"
                                             VerticalContentAlignment="Center" FontSize="13" Style="{StaticResource AccentTextBoxStyle}"
                                             ToolTip="实例名称"/>
                                    <Button Content="＋ 本地图片" Command="{Binding PickLocalIconCommand}" Height="32" Margin="12,0,0,0"
                                            Padding="12,0" FontSize="12" Background="#2D3036" Foreground="{StaticResource TextPrimaryBrush}" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#3A4048"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ===== 2. 模组加载器 ===== -->
                        <Border Style="{StaticResource CardStyle}" Padding="22" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="模组加载器" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="选择一个加载器（安装附带模块必须先选加载器）" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,14"/>
                                <ItemsControl ItemsSource="{Binding Loaders}" ItemTemplate="{StaticResource LoaderBlockTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- ===== 3. 附带模块 ===== -->
                        <Border Style="{StaticResource CardStyle}" Padding="22" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="附带模块" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="勾选后随实例一起安装（钠/虹膜/光影、小地图、模组菜单）" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,14"/>
                                <ItemsControl ItemsSource="{Binding Modules}" ItemTemplate="{StaticResource ModuleBlockTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- 底部悬浮栏（版本页打开时隐藏）-->
        <Border VerticalAlignment="Bottom" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="24,20" Margin="40,0,40,20" CornerRadius="12"
                Visibility="{Binding IsVersionPageOpen, Converter={StaticResource InvBool}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding DownloadStatus}" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <Button Grid.Column="1" Command="{Binding StartDownloadCommand}" Background="{StaticResource AccentBrush}" Width="160" Height="44" BorderThickness="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                <TextBlock x:Name="Txt" Text="创建实例" FontSize="15" FontWeight="Bold" Foreground="#15161A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#3A3D44"/>
                                    <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    <Setter TargetName="Txt" Property="Text" Value="创建中..."/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

            <!-- ===== 版本选择：独立整页（CardStyle 背板，像设置页那样）===== -->
            <Border Style="{StaticResource CardStyle}" Padding="32" Margin="40"
                    Visibility="{Binding IsVersionPageOpen, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Button Click="VersionBack_Click" Width="40" Height="40" Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="20">
                                        <TextBlock Text="&#xE72B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <TextBlock Text="{Binding VersionPageTitle}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" Margin="14,0,0,0"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding VersionPageItems}" PreviewMouseLeftButtonUp="VersionList_PreviewMouseLeftButtonUp">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- 效果1：描边慢慢浮现 + 内容高斯模糊 + 下载图标居中平滑出现 -->
                                    <Border Background="#0AFFFFFF" CornerRadius="8" Margin="0,0,0,8"
                                            BorderThickness="2" ClipToBounds="True">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid x:Name="CardContent" Height="48">
                                                <Grid.Effect><BlurEffect Radius="0"/></Grid.Effect>
                                                <TextBlock Text="{Binding}" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"
                                                           VerticalAlignment="Center" Margin="8,0"/>
                                            </Grid>
                                            <TextBlock x:Name="HoverIcon" Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="30" Foreground="{StaticResource AccentBrush}" Opacity="0"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                        </Grid>
                                        <Border.Triggers>
                                            <EventTrigger RoutedEvent="MouseEnter">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="CardContent" Storyboard.TargetProperty="(UIElement.Effect).(BlurEffect.Radius)" To="6" Duration="0:0:0.2" FillBehavior="HoldEnd"/>
                                                        <DoubleAnimation Storyboard.TargetName="HoverIcon" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" FillBehavior="HoldEnd"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                            <EventTrigger RoutedEvent="MouseLeave">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="CardContent" Storyboard.TargetProperty="(UIElement.Effect).(BlurEffect.Radius)" To="0" Duration="0:0:0.2" FillBehavior="HoldEnd"/>
                                                        <DoubleAnimation Storyboard.TargetName="HoverIcon" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" FillBehavior="HoldEnd"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Border.Triggers>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
    </Grid>
</UserControl>
